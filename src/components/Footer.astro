---
import { SITE_TITLE, SOCIALS } from '../consts';

const today = new Date();
---

<footer class="mt-24 border-t border-hair/60 bg-ink-soft">
	<div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-14">
		<p class="max-w-xl text-sm leading-relaxed text-dust">
			Views here are my own and do not represent my employer.
		</p>

		<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
			<p class="font-mono text-xs tracking-wide text-dust">
				&copy; {today.getFullYear()} {SITE_TITLE}
			</p>

			<div class="flex items-center gap-6 text-sm">
				<a
					href={SOCIALS.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="text-ash no-underline transition-colors duration-200 hover:text-chalk"
				>
					LinkedIn
				</a>
				<a
					href={SOCIALS.github}
					target="_blank"
					rel="noopener noreferrer"
					class="text-ash no-underline transition-colors duration-200 hover:text-chalk"
				>
					GitHub
				</a>
				<a
					href="/rss.xml"
					class="text-ash no-underline transition-colors duration-200 hover:text-chalk"
				>
					RSS
				</a>
			</div>
		</div>
	</div>
</footer>
