---
import { SITE_TITLE, SOCIALS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a
	href="#content"
	class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-sand focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-ink"
>
	Skip to content
</a>

<header class="sticky top-0 z-50 border-b border-hair/60 bg-ink/80 backdrop-blur-xl">
	<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
		<a href="/" class="group flex items-center gap-2.5 no-underline">
			<span
				class="grid h-7 w-7 place-items-center rounded border border-hair bg-ink-raise font-mono text-[11px] tracking-tight text-sand transition-colors duration-200 group-hover:border-sand/40"
			>
				KB
			</span>
			<span class="text-sm font-semibold tracking-tight text-chalk">{SITE_TITLE}</span>
		</a>

		<div class="flex items-center gap-6">
			<div class="flex items-center gap-6">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Writing</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>

			<div class="hidden items-center gap-4 border-l border-hair pl-6 sm:flex">
				<a
					href={SOCIALS.github}
					target="_blank"
					rel="noopener noreferrer"
					class="text-dust transition-colors duration-200 hover:text-chalk"
				>
					<span class="sr-only">GitHub profile</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a
					href={SOCIALS.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="text-dust transition-colors duration-200 hover:text-chalk"
				>
					<span class="sr-only">LinkedIn profile</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M3.6 5.4H.8V15h2.8V5.4zM2.2 1a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2zM15.2 9.6c0-2.7-1.5-4.4-3.7-4.4-1.3 0-2.2.7-2.6 1.4h-.1V5.4H6.1c0 .8.1 9.6.1 9.6h2.8V9.7c0-.3 0-.6.1-.8.2-.6.7-1.2 1.6-1.2 1.1 0 1.7.8 1.7 2.1V15h2.8V9.6z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
</header>
