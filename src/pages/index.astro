---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS, PROFILE } from '../consts';

// --- Data Collections --------------------------------------------------------

/** Quick impact metrics for the hero bar */
const metrics = [
	{
		value: '3.5+ Yrs',
		label: 'Acquia DXP Support',
		sub: 'Enterprise cloud & Site Factory',
	},
	{
		value: '1.5 Yrs',
		label: 'Telecom Operations',
		sub: 'Bharti Airtel via Diksha',
	},
	{
		value: '9x Exams',
		label: 'Competitive Testing',
		sub: 'UPSC CDS (3x), AFCAT (5x), IR (1x)',
	},
	{
		value: '99.9%',
		label: 'Reliability Mindset',
		sub: 'SLO, MTTR & runbook focus',
	},
];

/** Stacking capability cards (Option B) */
const capabilities = [
	{
		numeral: '01',
		title: 'DXP Support & Enterprise Escalations',
		headline: 'Front-line and Sev-1 escalation ownership for mission-critical enterprise Drupal platforms on Acquia Cloud.',
		body: 'Deep-dive diagnostics into PHP core stack traces, MySQL query bottlenecks, memory exhaustion, Varnish cache topologies, and containerized platform infrastructure. Getting production quiet again when the stakes are highest.',
		tags: ['Drupal 9/10', 'Acquia Cloud', 'Site Factory', 'Escalations', 'Varnish / CDN'],
		inverted: false,
	},
	{
		numeral: '02',
		title: 'Site Reliability & SRE Practices',
		headline: 'Translating recurring production friction into deterministic runbooks, SLOs, and proactive telemetry.',
		body: 'Turning customer pain into observable telemetry. Leveraging Datadog, New Relic, synthetic monitors, and distributed tracing so that production incidents are diagnosed in minutes and resolved without repeating manual toil.',
		tags: ['SLOs & Error Budgets', 'Datadog', 'New Relic APM', 'Incident Response', 'Postmortems'],
		inverted: false,
	},
	{
		numeral: '03',
		title: 'DevOps & Container Platforms',
		headline: 'Containerizing services, wiring pipelines, and architecting resilient infrastructure on Kubernetes and AWS.',
		body: 'Moving applications into lightweight immutable OCI containers, orchestrating declarative Kubernetes manifests, Helm charts, and building automated GitHub Actions CI/CD pipelines that make deployments non-events.',
		tags: ['Docker', 'Kubernetes', 'AWS Cloud', 'CI/CD Pipelines', 'Python Automation', 'n8n'],
		inverted: true, // Inverted bold accent card (Mayank style)
	},
	{
		numeral: '04',
		title: 'Crisis Leadership & Incident Command',
		headline: 'Battle-tested composure, structured decision-making, and blameless engineering mentorship.',
		body: 'Tempered by clearing UPSC CDS thrice, AFCAT five times, and facing multiple 5-day Services Selection Board (SSB) command task evaluations. Bringing military-grade psychological calm, rapid situational reaction (SRT), and clear communication into bridge calls and incident command.',
		tags: ['Incident Command', 'SSB Vetted', 'Crisis Composure', 'Team Enablement', 'Mentorship'],
		inverted: false,
	},
];

/** Horizontal Career Milestones (Option C) */
const timeline = [
	{
		year: '2016',
		role: 'B.Tech Engineering Graduation',
		org: 'Foundational Rigor',
		note: 'Graduated with a Bachelor of Technology. Developed core analytical thinking, curiosity for complex systems, and the discipline that set the foundation for competitive testing.',
	},
	{
		year: '2016 – 2021',
		role: 'The Crucible: UPSC CDS (3x) · AFCAT (5x) · SSB',
		org: 'Armed Forces & National Exam Testing',
		note: 'Cleared UPSC CDS 3 times, AFCAT 5 times, and Indian Railways once. Attended multiple 5-day Services Selection Board (SSB) interviews — rigorous evaluations of officer-like qualities (OLQs), psychological endurance, rapid decision-making under pressure, and leading teams through complex command tasks.',
	},
	{
		year: 'June 2021',
		role: 'Application & Database Operations Engineer',
		org: 'Diksha Technologies · Bharti Airtel',
		note: 'Entered IT operations on 24x7 mission-critical telecom billing and database nodes. Applied disciplined crisis communication to keep cross-tier engineering and leadership teams coordinated during major network incidents.',
	},
	{
		year: 'Dec 2022',
		role: 'Drupal DXP Support Engineer',
		org: 'Acquia',
		note: 'Supporting enterprise Drupal platforms on Acquia Cloud. 3.5+ years owning Sev-1 escalations, diagnosing 500+ production incidents, profiling database deadlocks, and authoring internal runbooks that reduced MTTR by ~25%.',
	},
	{
		year: 'Now',
		role: 'DevOps & Platform Engineering',
		org: 'Platform Architecture & Leadership',
		note: 'Going deeper into containers, Kubernetes, AWS, and CI/CD pipelines — advancing from fixing platform outages to architecting resilient systems that fail gracefully.',
	},
];

/** Filterable tech stack matrix categorized by domain */
const stackCategories = [
	{ id: 'all', label: 'All Technologies' },
	{ id: 'containers', label: 'Containers & K8s' },
	{ id: 'cloud', label: 'Cloud & Linux' },
	{ id: 'cicd-auto', label: 'CI/CD & Automation' },
	{ id: 'dxp-data', label: 'DXP & Observability' },
];

const techStack = [
	{
		name: 'Docker',
		category: 'containers',
		role: 'Containers & Packaging',
		status: 'Core Focus',
		description: 'Containerizing stateful applications, optimizing multi-stage image builds, reducing surface attack area.',
		tag: 'OCI / Dockerfile',
	},
	{
		name: 'Kubernetes',
		category: 'containers',
		role: 'Orchestration & Deployments',
		status: 'Upskilling Focus',
		description: 'Declarative manifests, Pod lifecycle, Services, Ingress routing, Helm charts, and cluster resilience.',
		tag: 'k8s / Helm',
	},
	{
		name: 'AWS',
		category: 'cloud',
		role: 'Cloud Infrastructure',
		status: 'Active',
		description: 'EC2, EKS, VPC networking, IAM security policies, S3, and CloudWatch metrics.',
		tag: 'AWS Cloud',
	},
	{
		name: 'CI/CD Pipelines',
		category: 'cicd-auto',
		role: 'Automated Delivery',
		status: 'Core Focus',
		description: 'GitHub Actions, automated test suites, artifact packaging, zero-downtime deployment strategies.',
		tag: 'GitHub Actions',
	},
	{
		name: 'Python',
		category: 'cicd-auto',
		role: 'Automation & Scripting',
		status: 'Active',
		description: 'Automating diagnostic queries, log parsers, API webhooks, and SRE utility scripts.',
		tag: 'Python 3',
	},
	{
		name: 'n8n',
		category: 'cicd-auto',
		role: 'Workflow Orchestration',
		status: 'Core Focus',
		description: 'Self-hosted workflow automations, incident escalation webhooks, Slack/Jira sync, and alert triage.',
		tag: 'Workflow Automation',
	},
	{
		name: 'Linux / Bash',
		category: 'cloud',
		role: 'Systems & Diagnostics',
		status: 'Veteran',
		description: 'System resource profiling (top, vmstat, strace), systemd, shell automation, permissions & networking.',
		tag: 'POSIX Shell',
	},
	{
		name: 'Drupal DXP',
		category: 'dxp-data',
		role: 'Enterprise CMS Platform',
		status: 'Expert (3.5+ yrs)',
		description: 'Core architecture, Drush CLI, Site Factory multi-site management, Acquia Cloud platform integration.',
		tag: 'Acquia DXP',
	},
	{
		name: 'MySQL & Databases',
		category: 'dxp-data',
		role: 'Data Layer & RDBMS',
		status: 'Veteran',
		description: 'Index optimization, slow-query log analysis, connection pooling, and schema migration integrity.',
		tag: 'SQL / Tuning',
	},
	{
		name: 'Datadog & APM',
		category: 'dxp-data',
		role: 'Observability & Tracing',
		status: 'Active',
		description: 'Synthetics, APM distributed trace diagnosis, memory leak tracking, and SLO metric alerting.',
		tag: 'New Relic / Datadog',
	},
];

/** Interactive terminal simulator tabs */
const terminalScenarios = [
	{
		id: 'cluster',
		title: 'k8s-health.sh',
		desc: 'Automated Kubernetes cluster health check & node diagnostics',
		output: [
			{ type: 'cmd', text: 'keshav@platform:~$ ./k8s-health.sh --cluster prod-us-east-1' },
			{ type: 'info', text: '[INFO] Connecting to Kubernetes API via IAM OIDC authentication...' },
			{ type: 'success', text: '✔ Control Plane Status: HEALTHY (Kubernetes v1.30.2)' },
			{ type: 'info', text: '[INFO] Evaluating worker nodes memory and CPU pressure...' },
			{ type: 'success', text: '✔ Node 01: Ready | CPU: 38% | Mem: 4.2GB / 16GB' },
			{ type: 'success', text: '✔ Node 02: Ready | CPU: 44% | Mem: 5.1GB / 16GB' },
			{ type: 'success', text: '✔ Node 03: Ready | CPU: 29% | Mem: 3.8GB / 16GB' },
			{ type: 'info', text: '[INFO] Ingress controller & SSL certificate validation...' },
			{ type: 'success', text: '✔ Ingress Gateway: 0 dropped packets | TLS cert valid (expires in 78 days)' },
			{ type: 'highlight', text: '⚡ Diagnostic result: 0 anomalies detected. Pod crashLoopBackOff = 0.' },
		],
	},
	{
		id: 'triage',
		title: 'triage-incident.py',
		desc: 'Automated APM log parser and slow query isolate script',
		output: [
			{ type: 'cmd', text: 'keshav@platform:~$ python3 triage-incident.py --incident INC-8921 --service drupal-api' },
			{ type: 'info', text: '[TRIAGE] Fetching New Relic & Datadog trace logs for last 30 minutes...' },
			{ type: 'warning', text: '⚠ Spike detected: P99 latency reached 4,820ms at 00:48:12 UTC' },
			{ type: 'info', text: '[TRIAGE] Correlating slow query log with database transactions...' },
			{ type: 'warning', text: '⚠ Identified query bottleneck: SELECT taxonomy_index WHERE nid IN (...)' },
			{ type: 'info', text: '[ACTION] Generating missing index suggestion and memory cache flush command...' },
			{ type: 'success', text: '✔ Created transient memcached warm rule to shield database pool' },
			{ type: 'highlight', text: '⚡ P99 latency restored: 142ms. Incident report appended to Jira INC-8921.' },
		],
	},
	{
		id: 'n8n',
		title: 'n8n-alert-sync.json',
		desc: 'Event-driven webhook bridge from Datadog to Slack and PagerDuty',
		output: [
			{ type: 'cmd', text: 'keshav@platform:~$ n8n-cli run --workflow "Escalation Enriched Triage"' },
			{ type: 'info', text: '[TRIGGER] Inbound Webhook received from Datadog Monitor #44892' },
			{ type: 'info', text: '[NODE: Extract Payload] Severity: CRITICAL | Host: acquia-prod-cluster' },
			{ type: 'info', text: '[NODE: Deduplication] Checked against active incidents in Redis: NEW INCIDENT' },
			{ type: 'info', text: '[NODE: Runbook Matcher] Matched Runbook: "RUN-042: High Memory Consumption"' },
			{ type: 'success', text: '✔ Dispatched enriched incident message with Runbook link to #platform-incidents' },
			{ type: 'success', text: '✔ Page sent to Primary On-Call Engineer with contextual diagnostic dump' },
			{ type: 'highlight', text: '⚡ Workflow execution completed in 84ms. 100% automated handoff.' },
		],
	},
];

/** Technical thoughts and blog posts */
const posts = [
	{
		title: 'From the Escalation Queue to On-Call SRE',
		category: 'Reliability',
		date: 'Sep 2026',
		readTime: '6 min read',
		note: 'Why troubleshooting 500+ production outages in enterprise Drupal is the ultimate foundation for platform resilience.',
		slug: 'first-post',
	},
	{
		title: 'Containerising a Legacy Stateful Stack Without Outages',
		category: 'DevOps',
		date: 'Aug 2026',
		readTime: '8 min read',
		note: 'Moving complex, plugin-heavy applications into Kubernetes: volumes, state, and zero-downtime traffic shifts.',
		slug: 'second-post',
	},
	{
		title: 'Automating the Support Runbook with Python & n8n',
		category: 'Automation',
		date: 'Jul 2026',
		readTime: '5 min read',
		note: 'How replacing manual ticket triage with event-driven webhooks reclaimed hours of engineering focus every week.',
		slug: 'third-post',
	},
	{
		title: 'Error Budgets & SLOs for Support-Led Engineering Teams',
		category: 'Leadership',
		date: 'Jun 2026',
		readTime: '7 min read',
		note: 'Translating customer pain and recurring tickets into technical reliability metrics that leadership buys into.',
		slug: 'markdown-style-guide',
	},
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — Drupal DXP Support to DevOps & Platform Engineering`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body class="bg-ink text-ash selection:bg-sand selection:text-ink relative">
		<!-- Analog film grain texture overlay (Mayank style) -->
		<div class="grain" aria-hidden="true"></div>

		<!-- Subtle ambient atmospheric glow -->
		<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
			<div
				class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-sand/[0.05] blur-[160px]"
			>
			</div>
			<div
				class="absolute top-1/2 right-0 h-[30rem] w-[30rem] -translate-y-1/2 rounded-full bg-sand/[0.03] blur-[140px]"
			>
			</div>
		</div>

		<Header />

		<main id="content" class="w-full">
			<!-- Option A: Hero Section with Interactive Physics Dot Canvas -->
			<section class="relative min-h-[92dvh] overflow-hidden border-b border-hair/70 flex flex-col justify-center">
				<!-- Interactive Canvas Field (Option A) -->
				<canvas
					id="field"
					aria-hidden="true"
					class="pointer-events-none absolute inset-0 h-full w-full"
				></canvas>

				<div class="relative mx-auto w-full max-w-5xl px-6 py-20 sm:py-28">
					<!-- Live status badge -->
					<div class="flex flex-wrap items-center gap-3">
						<div
							class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-medium text-emerald-300 backdrop-blur-md"
						>
							<span class="relative flex h-2 w-2">
								<span
									class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
								></span>
								<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
							</span>
							<span>Available for DevOps & Platform Engineering Roles</span>
						</div>

						<span class="font-mono text-xs text-dust">|</span>

						<p class="font-mono text-[11px] uppercase tracking-[0.22em] text-sand font-semibold">
							Acquia DXP Support ➔ DevOps
						</p>
					</div>

					<!-- Main Headline -->
					<h1
						class="mt-8 max-w-4xl text-4xl font-extrabold leading-[1.0] tracking-[-0.035em] text-chalk sm:text-6xl lg:text-7xl"
					>
						From the escalation queue
						<span class="block text-sand">to the platform.</span>
					</h1>

					<!-- Subheading with narrative -->
					<p class="mt-7 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
						I am <strong class="font-bold text-chalk">{PROFILE.name}</strong>. Over 5 years keeping enterprise digital systems resilient — 3.5+ years resolving critical enterprise Drupal DXP escalations at <span class="text-chalk font-semibold">Acquia</span>, preceded by high-volume telecom database operations at <span class="text-chalk font-semibold">Bharti Airtel</span>.
					</p>

					<p class="mt-3 max-w-2xl text-base leading-relaxed text-dust">
						Tested in the crucible of armed forces competitive leadership (cleared <strong class="text-ash font-medium">UPSC CDS 3x, AFCAT 5x</strong>, multiple SSBs). Now leveling up from triaging platforms to architecting them with <strong class="text-ash font-medium">Docker, Kubernetes, AWS, automated CI/CD pipelines, and Python</strong>.
					</p>

					<!-- Action CTAs + Dynamic Copy Email Button -->
					<div class="mt-10 flex flex-wrap items-center gap-4">
						<a
							href="#capabilities"
							class="group inline-flex items-center gap-2 rounded-full bg-chalk px-6 py-3.5 text-sm font-bold text-ink no-underline transition-all duration-200 hover:bg-sand hover:shadow-lg hover:shadow-sand/10"
						>
							What I am Hired For
							<span
								class="transition-transform duration-200 group-hover:translate-x-1"
								aria-hidden="true">&rarr;</span
							>
						</a>

						<a
							href="#journey"
							class="inline-flex items-center rounded-full border border-hair bg-ink-soft/80 backdrop-blur-md px-5 py-3.5 text-sm font-semibold text-chalk no-underline transition-colors duration-200 hover:border-sand/40 hover:text-sand"
						>
							Career Milestones & Leadership
						</a>

						<!-- Interactive Copy Email Button -->
						<div class="relative">
							<button
								id="copy-email-btn"
								type="button"
								data-email={SOCIALS.emailRaw}
								class="group inline-flex items-center gap-2 rounded-full border border-hair bg-ink-raise px-4 py-3.5 text-sm font-mono text-ash transition-colors duration-200 hover:border-sand/50 hover:text-chalk"
								title="Click to copy email address"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-sand transition-transform group-hover:scale-110"
								>
									<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
									<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
								</svg>
								<span id="copy-btn-text">Copy Email</span>
							</button>

							<!-- Tooltip feedback toast -->
							<div
								id="copy-toast"
								role="status"
								class="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 rounded bg-sand px-2.5 py-1 text-xs font-semibold text-ink opacity-0 shadow-md transition-all duration-200"
							>
								Copied to clipboard!
							</div>
						</div>
					</div>

					<!-- Quick Impact Metrics Grid -->
					<div
						class="mt-14 grid w-full grid-cols-2 gap-4 border-t border-hair/70 pt-8 sm:grid-cols-4 sm:gap-6"
					>
						{
							metrics.map((metric) => (
								<div class="flex flex-col rounded-lg border border-hair/50 bg-ink-soft/70 backdrop-blur-sm p-4 transition-colors duration-200 hover:border-sand/30">
									<span class="font-mono text-2xl font-bold tracking-tight text-sand sm:text-3xl">
										{metric.value}
									</span>
									<span class="mt-1 text-sm font-semibold text-chalk">{metric.label}</span>
									<span class="mt-0.5 text-xs text-dust">{metric.sub}</span>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Option B: Sticky Stacking Capability Cards ("What I am hired for") -->
			<section id="capabilities" class="relative">
				<div class="mx-auto max-w-5xl px-6 pt-24 pb-8 sm:pt-32 sm:pb-12">
					<p class="font-mono text-[11px] uppercase tracking-[0.2em] text-sand">
						Engineered Core Competencies
					</p>
					<h2 class="mt-2 text-3xl font-extrabold tracking-tight text-chalk sm:text-5xl">
						What I am hired for
					</h2>
					<p class="mt-2 text-sm text-dust max-w-lg">
						Scroll down to explore core capability layers.
					</p>
				</div>

				<!-- Stacking Card Deck -->
				<div class="space-y-0">
					{
						capabilities.map((cap, idx) => (
							<article
								style={`z-index: ${idx + 1}`}
								class:list={[
									'stack-card sticky top-0 flex min-h-[90vh] sm:min-h-[100vh] items-center border-t border-hair',
									cap.inverted ? 'bg-sand text-ink' : 'bg-ink text-ash',
								]}
							>
								<div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-8 px-6 py-16 sm:grid-cols-12 sm:gap-12">
									<!-- Giant Numeral Watermark -->
									<div class="sm:col-span-4 flex items-center">
										<span
											class:list={[
												'font-mono text-[clamp(6rem,14vw,11rem)] font-extrabold select-none leading-none',
												cap.inverted ? 'text-ink/20' : 'text-chalk/10',
											]}
											aria-hidden="true"
										>
											{cap.numeral}
										</span>
									</div>

									<!-- Card Details -->
									<div class="sm:col-span-8 flex flex-col justify-center">
										<h3
											class:list={[
												'text-2xl sm:text-4xl font-extrabold tracking-tight',
												cap.inverted ? 'text-ink' : 'text-chalk',
											]}
										>
											{cap.title}
										</h3>

										<p
											class:list={[
												'mt-4 text-base sm:text-lg font-semibold leading-relaxed',
												cap.inverted ? 'text-ink/90' : 'text-chalk/90',
											]}
										>
											{cap.headline}
										</p>

										<p
											class:list={[
												'mt-4 text-sm sm:text-base leading-relaxed',
												cap.inverted ? 'text-ink/80' : 'text-ash',
											]}
										>
											{cap.body}
										</p>

										<!-- Monospace Tags -->
										<ul class="mt-8 flex flex-wrap gap-2">
											{cap.tags.map((tag) => (
												<li
													class:list={[
														'rounded px-3 py-1 font-mono text-xs tracking-wider uppercase border',
														cap.inverted
															? 'border-ink/30 bg-ink/10 text-ink font-semibold'
															: 'border-hair bg-ink-raise text-dust',
													]}
												>
													{tag}
												</li>
											))}
										</ul>
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- Option C: Horizontal Career Rail with Giant Accent Years & SSB Leadership -->
			<section id="journey" class="relative overflow-hidden border-t border-hair/70 py-24 sm:py-32">
				<div class="mx-auto max-w-5xl px-6 mb-12">
					<div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
						<div>
							<p class="font-mono text-[11px] uppercase tracking-[0.2em] text-sand">
								Milestones & Leadership
							</p>
							<h2 class="mt-1 text-3xl font-extrabold tracking-tight text-chalk sm:text-5xl">
								From the testing crucible to cloud platforms
							</h2>
						</div>
						<span class="font-mono text-xs text-dust hidden sm:inline">
							Scroll or drag horizontally &rarr;
						</span>
					</div>
					<p class="mt-3 max-w-2xl text-base leading-relaxed text-ash">
						Nobody plans an engineering career on the escalation queue or in military screening boards. It turned out to be the most rigorous classroom for high-pressure incident command.
					</p>
				</div>

				<!-- Horizontal Scrolling Track -->
				<div
					id="pan-track"
					class="flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 pb-6 no-scrollbar md:gap-8 lg:px-12"
				>
					{
						timeline.map((item) => (
							<article class="w-[85vw] shrink-0 snap-start rounded-xl border border-hair bg-ink-soft p-6 transition-all hover:border-sand/40 sm:w-[50vw] lg:w-[32vw] flex flex-col justify-between">
								<div>
									<!-- Giant Accent Year -->
									<span class="block font-mono text-4xl sm:text-5xl font-extrabold tracking-tight text-sand">
										{item.year}
									</span>

