---
import BaseHead from '../components/BaseHead.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/profile/keshav-headshot.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImpactShowcase from '../components/ImpactShowcase.astro';
import CareerJourney from '../components/CareerJourney.astro';
import '../styles/portfolio.css';
import '../styles/learning-home.css';
import { SOCIALS } from '../consts';

const learning = [
 {number:'01', title:'Understanding Kubernetes', tag:'Containers & platforms', focus:'Connecting the support problems I investigate with the way container platforms behave.', foundation:'Experience supporting Drupal on Acquia Cloud Platform.', next:'Practice explaining Pods, Services, and failure scenarios in a small lab.', color:'mint'},
 {number:'02', title:'Making repetitive work easier', tag:'Python · CI/CD · n8n', focus:'Exploring how small automations can make troubleshooting and handovers more consistent.', foundation:'Day-to-day support workflows and collaboration on internal support tools.', next:'Build a focused automation and document where it helps—and where human judgment matters.', color:'lilac'},
 {number:'03', title:'Asking better reliability questions', tag:'Observability & SRE', focus:'Moving from “what failed?” toward “how could we spot it earlier?”', foundation:'Customer-facing technical investigation and escalation support.', next:'Explore useful service indicators and write down the reasoning behind an alert.', color:'peach'},
];
const writing = [
 {category:'Career & curiosity', title:'From the Escalation Queue to On-Call SRE', text:'The habits support has taught me, and the reliability skills I’m developing next.', href:'/blog/first-post/', number:'01'},
 {category:'People & mentoring', title:'Building Confidence, One Support Case at a Time', text:'Helping new teammates connect customer empathy with technical investigation.', href:'/blog/building-confidence-in-support/', number:'02'},
];
---
<!doctype html>
<html lang="en">
 <head><BaseHead title="Keshav Bhardwaj — Engineer, teammate, always learning" description="Support engineer at Acquia, growing into DevOps. Projects, practical notes, and reflections on helping customers and teammates move forward." /></head>
 <body class="portfolio learning-home bg-ink text-ash">
  <div class="infra-background" aria-hidden="true">
   <div class="infra-grid"></div>
   <div class="infra-terminal infra-terminal-code"><div class="infra-title"><span>● ● ●</span> &nbsp; deployment.yaml</div><div class="infra-code"><span class="code-purple">apiVersion:</span> apps/v1<br /><span class="code-purple">kind:</span> Deployment<br /><span class="code-purple">metadata:</span><br />&nbsp; <span class="code-purple">name:</span> <em>platform-api</em><br /><span class="code-purple">spec:</span><br />&nbsp; <span class="code-purple">replicas:</span> <b>3</b><br />&nbsp; <span class="code-purple">containers:</span><br />&nbsp; - <span class="code-purple">image:</span> <em>app:latest</em></div><div class="infra-typing">$ kubectl apply -f deployment.yaml<span class="infra-cursor">_</span></div></div>
   <div class="infra-terminal infra-terminal-build"><div class="infra-title"><span>●</span> &nbsp; BUILD PIPELINE</div><div class="infra-log-window"><div class="infra-log-stream">$ docker build -t app .<br /><em>✓ loading build context</em><br />&gt; installing dependencies<br /><em>✓ image built</em><br />&gt; deploying containers<br /><em>✓ rollout complete</em><br />$ docker build -t app .<br /><em>✓ loading build context</em><br />&gt; installing dependencies<br /><em>✓ image built</em><br />&gt; deploying containers<br /><em>✓ rollout complete</em></div></div><div class="infra-progress"><i></i></div></div>
   <div class="infra-terminal infra-terminal-events"><div class="infra-title"><span>●</span> &nbsp; CLUSTER EVENTS</div><div class="infra-pod"><i></i> api-7d8f <em>RUNNING</em></div><div class="infra-pod"><i></i> worker-42 <em>RUNNING</em></div><div class="infra-event"><strong>OOMKilled</strong> <span>→ restarting</span></div><div class="infra-recovery">↳ container healthy <em>✓</em></div></div>
   <div class="server-visual"><div class="server-visual-orbit"></div><div class="server-visual-core"><img src="/server-rack.svg" alt="" /><i></i><i></i></div><div class="server-visual-label">SERVER <span>● ONLINE</span></div><div class="server-visual-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
   <div class="infra-orbit infra-orbit-one"></div><div class="infra-orbit infra-orbit-two"></div>
  </div>
  <Header />
  <main id="content">
   <section class="welcome" aria-labelledby="welcome-title">
    <div class="welcome-glow" aria-hidden="true"></div>
    <div class="welcome-copy">
     <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Engineer. Teammate. Always a learner.</p>
     <h1 id="welcome-title">Building reliable systems.<br /><span>Helping people grow.</span></h1>
     <p class="intro">Hi, I’m Keshav <span aria-hidden="true">↗</span></p>
     <p class="welcome-description">A support engineer at Acquia exploring DevOps and platform engineering. I enjoy untangling difficult problems, sharing what I learn, and helping teammates find their next step.</p>
     <div class="welcome-actions"><a class="primary-link" href="#projects">Explore my work <span aria-hidden="true">↗</span></a><a class="secondary-link" href="#contact">Let’s talk <span aria-hidden="true">→</span></a></div>
     <p class="welcome-footnote">Based in India · Supporting customers across EMEA & APJ</p>
    </div>
    <aside class="desk-note portrait-note" aria-label="Meet Keshav">
     <Image src={headshot} alt="Keshav Bhardwaj smiling, wearing glasses and a blue blazer" widths={[320, 480, 720]} sizes="(max-width: 800px) calc(100vw - 40px), 400px" width={480} height={480} format="webp" loading="eager" class="profile-photo" />
     <div class="portrait-caption">
     <div class="note-top"><span>A NOTE FROM MY DESK</span><span aria-hidden="true">✳</span></div>
     <p class="note-quote">“Let’s figure<br />it out together.”</p>
     <p>That’s how I like to start—with a question, a little patience, and room to learn.</p>
     <div class="note-bottom"><span class="initials">KB</span><span>Keshav Bhardwaj<br /><small>Curious by default.</small></span></div>
     </div>
    </aside>
   </section>
   <nav class="home-nav" aria-label="Explore this page"><a href="#learning">Currently learning</a><a href="#projects">Things I build</a><a href="#impact">Growing together</a><a href="#writing">My notebook</a></nav>
   <section id="learning" class="home-section" aria-labelledby="learning-title">
    <div class="section-heading"><div><p class="eyebrow">A work in progress, in the best way</p><h2 id="learning-title">What I’m learning now.</h2></div><span class="small-note">Questions welcome. Always.</span></div>
    <p class="section-intro">My support experience is the starting point. These are the areas I’m exploring next—not a list of things I’ve mastered.</p>
    <div class="learning-grid">{learning.map(item => <article class:list={['learning-card', item.color]}>
     <div class="card-top"><span>{item.number} / LEARNING NOTES</span><span aria-hidden="true">↗</span></div>
     <p class="topic">{item.tag}</p><h3>{item.title}</h3><p>{item.focus}</p>
     <dl><dt>What I bring</dt><dd>{item.foundation}</dd><dt>Next step</dt><dd>{item.next}</dd></dl>
    </article>)}</div>
   </section>
   <ImpactShowcase section="projects" />
   <section class="practice-note" aria-label="My approach to building">
    <span aria-hidden="true">↳</span><div><h3>Build something useful. Stay curious about its limits.</h3><p>IP Analyser helps investigate existing logs; it isn’t real-time analytics. SpeedSentry estimates download speed; it isn’t a complete picture of network health. Explaining those boundaries is part of sharing the work.</p></div>
   </section>
   <ImpactShowcase section="impact" />
   <section id="writing" class="home-section" aria-labelledby="writing-title">
    <div class="section-heading"><div><p class="eyebrow">Notes from the journey</p><h2 id="writing-title">A few things worth sharing.</h2></div><a href="/blog/">Browse the notebook ↗</a></div>
    <div class="writing-grid">{writing.map(post => <article class="writing-card"><p class="eyebrow">{post.category}</p><h3><a href={post.href}>{post.title}</a></h3><p>{post.text}</p><a class="read-link" href={post.href}>Read the story <span aria-hidden="true">→</span></a></article>)}
     <article class="writing-card"><p class="eyebrow">Open source & practical tools</p><h3><a href="/blog/why-i-built-ip-analyser/">Why I built IP Analyser</a></h3><p>Turning customer questions about traffic consumption into a Drupal investigation tool.</p><a class="read-link" href="/blog/why-i-built-ip-analyser/">Read the story ↗</a></article>
    </div>
   </section>
   <CareerJourney />
   <section id="contact" class="contact-note" aria-labelledby="contact-title">
    <p class="eyebrow">No perfect question required</p><h2 id="contact-title">Let’s exchange notes.</h2>
    <p>Working through a tricky problem, learning something new, or starting in support? I’m happy to connect, compare approaches, and learn from your experience too.</p>
    <div class="welcome-actions"><a class="primary-link" href={SOCIALS.email}>Say hello <span aria-hidden="true">↗</span></a><a class="secondary-link" href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">Find me on LinkedIn</a></div>
    <p class="small-note">Personal projects and reflections. Views are my own.</p>
   </section>
  </main>
  <Footer />
 </body>
</html>

