		<!-- Option A: Hero Physics Canvas Engine & Interactive Scripts -->
		<script is:inline>
			// --- 1. Option A: Hero Physics Particle/Dot Field ---
			(function () {
				const canvas = document.getElementById('field');
				if (!canvas) return;

				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const ctx = canvas.getContext('2d');
				if (!ctx) return;

				let particles = [];
				let dpr = 1;
				let mouse = { x: -9999, y: -9999 };
				let animFrameId = 0;

				const initGrid = () => {
					const rect = canvas.getBoundingClientRect();
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					canvas.width = Math.round(rect.width * dpr);
					canvas.height = Math.round(rect.height * dpr);
					ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

					particles = [];
					const spacing = 28;
					for (let y = 20; y < rect.height; y += spacing) {
						for (let x = 20; x < rect.width; x += spacing) {
							particles.push({
								x: x,
								y: y,
								ox: x,
								oy: y,
								vx: 0,
								vy: 0,
							});
						}
					}
				};

				const render = () => {
					const rect = canvas.getBoundingClientRect();
					ctx.clearRect(0, 0, rect.width, rect.height);

					const accentColor = '#e8b17a';
					const dotColor = '#ededf0';

					for (let i = 0; i < particles.length; i++) {
						const pt = particles[i];
						const dx = pt.x - mouse.x;
						const dy = pt.y - mouse.y;
						const dist = Math.hypot(dx, dy);

						if (dist < 140 && !reducedMotion) {
							const force = Math.pow(1 - dist / 140, 2) * 32;
							pt.vx += (dx / (dist || 1)) * force * 0.08;
							pt.vy += (dy / (dist || 1)) * force * 0.08;
						}

						// Spring restitution back to origin
						pt.vx += (pt.ox - pt.x) * 0.045;
						pt.vy += (pt.oy - pt.y) * 0.045;
						pt.vx *= 0.86;
						pt.vy *= 0.86;
						pt.x += pt.vx;
						pt.y += pt.vy;

						const near = dist < 140;
						const rad = near ? 1.2 + (1 - dist / 140) * 1.8 : 1.1;

						ctx.beginPath();
						ctx.arc(pt.x, pt.y, rad, 0, Math.PI * 2);
						ctx.fillStyle = near ? accentColor : dotColor;
						ctx.globalAlpha = near ? 0.4 + (1 - dist / 140) * 0.5 : 0.12;
						ctx.fill();
					}

					animFrameId = requestAnimationFrame(render);
				};

				const onMouseMove = (e) => {
					const rect = canvas.getBoundingClientRect();
					mouse.x = e.clientX - rect.left;
					mouse.y = e.clientY - rect.top;
				};

				const onMouseLeave = () => {
					mouse.x = -9999;
					mouse.y = -9999;
				};

				initGrid();

				if (reducedMotion || window.matchMedia('(pointer: coarse)').matches) {
					// Static single-pass render for coarse pointer or reduced motion
					const rect = canvas.getBoundingClientRect();
					ctx.clearRect(0, 0, rect.width, rect.height);
					ctx.fillStyle = '#ededf0';
					ctx.globalAlpha = 0.12;
					for (let i = 0; i < particles.length; i++) {
						ctx.beginPath();
						ctx.arc(particles[i].ox, particles[i].oy, 1.1, 0, Math.PI * 2);
						ctx.fill();
					}
				} else {
					window.addEventListener('pointermove', onMouseMove, { passive: true });
					window.addEventListener('pointerleave', onMouseLeave);
					animFrameId = requestAnimationFrame(render);
				}

				let resizeTimer;
				window.addEventListener('resize', () => {
					clearTimeout(resizeTimer);
					resizeTimer = setTimeout(initGrid, 150);
				});
			})();

			// --- 2. Option C: Horizontal Track Scroll Progress ---
			(function () {
				const track = document.getElementById('pan-track');
				const progress = document.getElementById('pan-progress');
				if (track && progress) {
					track.addEventListener('scroll', () => {
						const maxScroll = track.scrollWidth - track.clientWidth;
						if (maxScroll > 0) {
							const percent = Math.min(Math.max((track.scrollLeft / maxScroll) * 100, 15), 100);
							progress.style.width = percent + '%';
						}
					});
				}
			})();

			// --- 3. Copy Email Interaction ---
			const copyBtn = document.getElementById('copy-email-btn');
			const copyToast = document.getElementById('copy-toast');
			const copyBtnText = document.getElementById('copy-btn-text');

			if (copyBtn && copyToast) {
				copyBtn.addEventListener('click', async () => {
					const email = copyBtn.getAttribute('data-email') || 'keshavec23@gmail.com';
					try {
						await navigator.clipboard.writeText(email);
						copyToast.classList.remove('opacity-0');
						copyToast.classList.add('opacity-100');
						if (copyBtnText) copyBtnText.textContent = 'Copied!';

						setTimeout(() => {
							copyToast.classList.remove('opacity-100');
							copyToast.classList.add('opacity-0');
							if (copyBtnText) copyBtnText.textContent = 'Copy Email';
						}, 2500);
					} catch (err) {
						console.error('Failed to copy text: ', err);
					}
				});
			}

			// --- 4. Dynamic Tech Stack Matrix Category Filtering ---
			const filterPills = document.querySelectorAll('.filter-pill');
			const stackCards = document.querySelectorAll('.stack-card');

			filterPills.forEach((pill) => {
				pill.addEventListener('click', () => {
					const category = pill.getAttribute('data-category');

					// Update active pill styling
					filterPills.forEach((p) => {
						p.classList.remove('bg-sand', 'font-bold', 'text-ink', 'shadow-sm');
						p.classList.add('border', 'border-hair', 'bg-ink-soft', 'text-dust');
					});
					pill.classList.remove('border', 'border-hair', 'bg-ink-soft', 'text-dust');
					pill.classList.add('bg-sand', 'font-bold', 'text-ink', 'shadow-sm');

					// Filter cards
					stackCards.forEach((card) => {
						const cardCat = card.getAttribute('data-category');
						if (category === 'all' || cardCat === category) {
							card.style.display = 'flex';
						} else {
							card.style.display = 'none';
						}
					});
				});
			});

			// --- 5. Interactive DevOps Terminal Simulator Tabs ---
			const terminalTabs = document.querySelectorAll('.terminal-tab');
			terminalTabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const scenarioId = tab.getAttribute('data-scenario');

					terminalTabs.forEach((t) => {
						t.classList.remove('bg-hair', 'text-chalk', 'font-semibold');
						t.classList.add('text-dust');
					});
					tab.classList.remove('text-dust');
					tab.classList.add('bg-hair', 'text-chalk', 'font-semibold');

					document.querySelectorAll('[id^="terminal-pane-"]').forEach((pane) => {
						pane.classList.add('hidden');
						pane.classList.remove('block');
					});
					const targetPane = document.getElementById(`terminal-pane-${scenarioId}`);
					if (targetPane) {
						targetPane.classList.remove('hidden');
						targetPane.classList.add('block');
					}
				});
			});
		</script>
