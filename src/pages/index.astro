---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS, PROFILE } from '../consts';

// --- Portfolio Data & Matrices ----------------------------------------------

/** Quick impact metrics for the hero bar */
const metrics = [
	{
		value: '3.5+ Yrs',
		label: 'Acquia DXP Support',
		sub: 'Enterprise cloud & Site Factory',
	},
	{
		value: '1.5 Yrs',
		label: 'Telecom Operations',
		sub: 'Bharti Airtel via Diksha',
	},
	{
		value: '500+',
		label: 'Escalations Resolved',
		sub: 'L3 production incidents',
	},
	{
		value: '99.9%',
		label: 'Reliability Mindset',
		sub: 'SLO, MTTR & runbook focus',
	},
];

/** Detailed interactive career journey entries */
const careerJourney = [
	{
		id: 'acquia',
		role: 'Drupal Digital Experience (DXP) Support Engineer',
		company: 'Acquia',
		location: 'Remote · India',
		period: 'Dec 2022 – Present (~3.5+ years)',
		badge: 'Enterprise Escalations & Cloud',
		current: true,
		headline: 'Front-line & escalation ownership for mission-critical enterprise Drupal platforms on Acquia Cloud.',
		summary:
			'Navigating the intersection of enterprise Drupal applications and cloud infrastructure. Responsible for triaging Sev-1 customer outages, conducting root-cause postmortems, profiling database bottlenecks, and mentoring teammates on diagnostic runbooks.',
		achievements: [
			'Debugged 500+ high-severity production tickets spanning stack traces, PHP fatal errors, memory leaks, and varnish/CDN cache invalidation failures.',
			'Collaborated with cloud platform engineers to isolate infrastructure anomalies across Acquia Cloud Next containerized architecture.',
			'Authored comprehensive internal runbooks on database deadlock isolation and automated cache clearing that reduced recurring MTTR by ~25%.',
			'Mentored newer support engineers in Linux command-line diagnostics, Drush utilities, and APM tracing with New Relic / Datadog.',
		],
		techStack: [
			'Drupal 9/10',
			'Acquia Cloud',
			'Site Factory',
			'MySQL / Aurora',
			'Varnish',
			'New Relic',
			'Datadog',
			'Drush',
			'Bash',
			'Git',
		],
	},
	{
		id: 'diksha',
		role: 'Application & Database Support / Operations Engineer',
		company: 'Diksha Technologies (Catering to Bharti Airtel)',
		location: 'Gurugram, India',
		period: 'June 2021 – Dec 2022 (1.5 years)',
		badge: 'Telecom 24x7 Operations & Reliability',
		current: false,
		headline: '24x7 mission-critical operations and database monitoring for national telecommunication infrastructure.',
		summary:
			'Managed high-volume telecom billing, provisioning, and customer-facing support systems. Gained deep empathy for systemic communication during production outages and built foundational discipline in Linux administration and database health.',
		achievements: [
			'Maintained 99.9% uptime compliance across critical billing and database servers under strict telecom SLAs.',
			'Triaged real-time telemetry alerts, identifying network hiccups and database locking issues before customer impact escalated.',
			'Automated recurring operational health-check audits using custom Bash cron jobs, eliminating ~4 hours of weekly manual reporting toil.',
			'Coordinated cross-functional bridge calls during major incidents, delivering clear executive situation reports (sitreps) and post-incident chronologies.',
		],
		techStack: [
			'Linux (RHEL / CentOS)',
			'Oracle DB',
			'MySQL',
			'Bash Scripting',
			'Splunk',
			'Incident Management',
			'Network Diagnostics',
			'Cron Automation',
		],
	},
];

/** Filterable tech stack matrix categorized by domain */
const stackCategories = [
	{ id: 'all', label: 'All Technologies' },
	{ id: 'containers', label: 'Containers & K8s' },
	{ id: 'cloud', label: 'Cloud & Linux' },
	{ id: 'cicd-auto', label: 'CI/CD & Automation' },
	{ id: 'dxp-data', label: 'DXP & Observability' },
];

const techStack = [
	{
		name: 'Docker',
		category: 'containers',
		role: 'Containers & Packaging',
		status: 'Core Focus',
		description: 'Containerizing stateful applications, optimizing multi-stage image builds, reducing surface attack area.',
		tag: 'OCI / Dockerfile',
	},
	{
		name: 'Kubernetes',
		category: 'containers',
		role: 'Orchestration & Deployments',
		status: 'Upskilling Focus',
		description: 'Declarative manifests, Pod lifecycle, Services, Ingress routing, Helm charts, and cluster resilience.',
		tag: 'k8s / Helm',
	},
	{
		name: 'AWS',
		category: 'cloud',
		role: 'Cloud Infrastructure',
		status: 'Active',
		description: 'EC2, EKS, VPC networking, IAM security policies, S3, and CloudWatch metrics.',
		tag: 'AWS Cloud',
	},
	{
		name: 'CI/CD Pipelines',
		category: 'cicd-auto',
		role: 'Automated Delivery',
		status: 'Core Focus',
		description: 'GitHub Actions, automated test suites, artifact packaging, zero-downtime deployment strategies.',
		tag: 'GitHub Actions',
	},
	{
		name: 'Python',
		category: 'cicd-auto',
		role: 'Automation & Scripting',
		status: 'Active',
		description: 'Automating diagnostic queries, log parsers, API webhooks, and SRE utility scripts.',
		tag: 'Python 3',
	},
	{
		name: 'n8n',
		category: 'cicd-auto',
		role: 'Workflow Orchestration',
		status: 'Core Focus',
		description: 'Self-hosted workflow automations, incident escalation webhooks, Slack/Jira sync, and alert triage.',
		tag: 'Workflow Automation',
	},
	{
		name: 'Linux / Bash',
		category: 'cloud',
		role: 'Systems & Diagnostics',
		status: 'Veteran',
		description: 'System resource profiling (top, vmstat, strace), systemd, shell automation, permissions & networking.',
		tag: 'POSIX Shell',
	},
	{
		name: 'Drupal DXP',
		category: 'dxp-data',
		role: 'Enterprise CMS Platform',
		status: 'Expert (3.5+ yrs)',
		description: 'Core architecture, Drush CLI, Site Factory multi-site management, Acquia Cloud platform integration.',
		tag: 'Acquia DXP',
	},
	{
		name: 'MySQL & Databases',
		category: 'dxp-data',
		role: 'Data Layer & RDBMS',
		status: 'Veteran',
		description: 'Index optimization, slow-query log analysis, connection pooling, and schema migration integrity.',
		tag: 'SQL / Tuning',
	},
	{
		name: 'Datadog & APM',
		category: 'dxp-data',
		role: 'Observability & Tracing',
		status: 'Active',
		description: 'Synthetics, APM distributed trace diagnosis, memory leak tracking, and SLO metric alerting.',
		tag: 'New Relic / Datadog',
	},
];

/** Interactive terminal simulator tabs */
const terminalScenarios = [
	{
		id: 'cluster',
		title: 'k8s-health.sh',
		desc: 'Automated Kubernetes cluster health check & node diagnostics',
		output: [
			{ type: 'cmd', text: 'keshav@platform:~$ ./k8s-health.sh --cluster prod-us-east-1' },
			{ type: 'info', text: '[INFO] Connecting to Kubernetes API via IAM OIDC authentication...' },
			{ type: 'success', text: '✔ Control Plane Status: HEALTHY (Kubernetes v1.30.2)' },
			{ type: 'info', text: '[INFO] Evaluating worker nodes memory and CPU pressure...' },
			{ type: 'success', text: '✔ Node 01: Ready | CPU: 38% | Mem: 4.2GB / 16GB' },
			{ type: 'success', text: '✔ Node 02: Ready | CPU: 44% | Mem: 5.1GB / 16GB' },
			{ type: 'success', text: '✔ Node 03: Ready | CPU: 29% | Mem: 3.8GB / 16GB' },
			{ type: 'info', text: '[INFO] Ingress controller & SSL certificate validation...' },
			{ type: 'success', text: '✔ Ingress Gateway: 0 dropped packets | TLS cert valid (expires in 78 days)' },
			{ type: 'highlight', text: '⚡ Diagnostic result: 0 anomalies detected. Pod crashLoopBackOff = 0.' },
		],
	},
	{
		id: 'triage',
		title: 'triage-incident.py',
		desc: 'Automated APM log parser and slow query isolate script',
		output: [
			{ type: 'cmd', text: 'keshav@platform:~$ python3 triage-incident.py --incident INC-8921 --service drupal-api' },
			{ type: 'info', text: '[TRIAGE] Fetching New Relic & Datadog trace logs for last 30 minutes...' },
			{ type: 'warning', text: '⚠ Spike detected: P99 latency reached 4,820ms at 00:48:12 UTC' },
			{ type: 'info', text: '[TRIAGE] Correlating slow query log with database transactions...' },
			{ type: 'warning', text: '⚠ Identified query bottleneck: SELECT taxonomy_index WHERE nid IN (...)' },
			{ type: 'info', text: '[ACTION] Generating missing index suggestion and memory cache flush command...' },
			{ type: 'success', text: '✔ Created transient memcached warm rule to shield database pool' },
			{ type: 'highlight', text: '⚡ P99 latency restored: 142ms. Incident report appended to Jira INC-8921.' },
		],
	},
	{
		id: 'n8n',
		title: 'n8n-alert-sync.json',
		desc: 'Event-driven webhook bridge from Datadog to Slack and PagerDuty',
		output: [
			{ type: 'cmd', text: 'keshav@platform:~$ n8n-cli run --workflow "Escalation Enriched Triage"' },
			{ type: 'info', text: '[TRIGGER] Inbound Webhook received from Datadog Monitor #44892' },
			{ type: 'info', text: '[NODE: Extract Payload] Severity: CRITICAL | Host: acquia-prod-cluster' },
			{ type: 'info', text: '[NODE: Deduplication] Checked against active incidents in Redis: NEW INCIDENT' },
			{ type: 'info', text: '[NODE: Runbook Matcher] Matched Runbook: "RUN-042: High Memory Consumption"' },
			{ type: 'success', text: '✔ Dispatched enriched incident message with Runbook link to #platform-incidents' },
			{ type: 'success', text: '✔ Page sent to Primary On-Call Engineer with contextual diagnostic dump' },
			{ type: 'highlight', text: '⚡ Workflow execution completed in 84ms. 100% automated handoff.' },
		],
	},
];

/** Technical thoughts and blog post placeholders */
const posts = [
	{
		title: 'From the Escalation Queue to On-Call SRE',
		category: 'Reliability',
		date: 'Sep 2026',
		readTime: '6 min read',
		note: 'Why troubleshooting 500+ production outages in enterprise Drupal is the ultimate foundation for platform resilience.',
		slug: 'first-post',
	},
	{
		title: 'Containerising a Legacy Stateful Stack Without Outages',
		category: 'DevOps',
		date: 'Aug 2026',
		readTime: '8 min read',
		note: 'Moving complex, plugin-heavy applications into Kubernetes: volumes, state, and zero-downtime traffic shifts.',
		slug: 'second-post',
	},
	{
		title: 'Automating the Support Runbook with Python & n8n',
		category: 'Automation',
		date: 'Jul 2026',
		readTime: '5 min read',
		note: 'How replacing manual ticket triage with event-driven webhooks reclaimed hours of engineering focus every week.',
		slug: 'third-post',
	},
	{
		title: 'Error Budgets & SLOs for Support-Led Engineering Teams',
		category: 'Leadership',
		date: 'Jun 2026',
		readTime: '7 min read',
		note: 'Translating customer pain and recurring tickets into technical reliability metrics that leadership buys into.',
		slug: 'markdown-style-guide',
	},
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — Drupal DXP Support to DevOps & Platform Engineering`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body class="bg-ink text-ash selection:bg-sand selection:text-ink">
		<!-- Subtle ambient atmospheric glow -->
		<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
			<div
				class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-sand/[0.06] blur-[150px]"
			>
			</div>
			<div
				class="absolute top-1/2 right-0 h-[30rem] w-[30rem] -translate-y-1/2 rounded-full bg-sand/[0.03] blur-[130px]"
			>
			</div>
		</div>

		<Header />

		<main id="content" class="mx-auto w-full max-w-5xl px-6 py-0">
			<!-- Hero Section -->
			<section class="flex flex-col items-start pt-20 pb-20 sm:pt-28 sm:pb-24">
				<!-- Live status badge -->
				<div class="flex flex-wrap items-center gap-3">
					<div
						class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-medium text-emerald-300"
					>
						<span class="relative flex h-2 w-2">
							<span
								class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
							></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
						</span>
						<span>Available for DevOps & Platform Engineering Roles</span>
					</div>

					<span class="font-mono text-xs text-dust">|</span>

					<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">
						Acquia DXP Support Engineer
					</p>
				</div>

				<!-- Main Headline -->
				<h1
					class="mt-8 max-w-3xl text-4xl font-bold leading-[1.02] tracking-[-0.03em] text-chalk sm:text-6xl lg:text-7xl"
				>
					From the escalation queue
					<span class="block text-sand">to the platform.</span>
				</h1>

				<!-- Subheading with career trajectory -->
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
					I am <strong class="font-semibold text-chalk">{PROFILE.name}</strong>. Over 5 years keeping
					production resilient — 3.5+ years resolving critical enterprise Drupal DXP escalations at
					<span class="text-chalk font-medium">Acquia</span>, preceded by high-volume telecom database
					and operations support at <span class="text-chalk font-medium">Bharti Airtel</span>.
				</p>

				<p class="mt-3 max-w-2xl text-base leading-relaxed text-dust">
					Now leveling up from triaging platforms to architecting them: <strong class="text-ash font-medium">Docker, Kubernetes, AWS, automated CI/CD pipelines, Python, and n8n workflows</strong> that make system failures rare and recovery automated.
				</p>

				<!-- Action CTAs + Dynamic Copy Email Button -->
				<div class="mt-10 flex flex-wrap items-center gap-4">
					<a
						href="#journey"
						class="group inline-flex items-center gap-2 rounded-full bg-chalk px-6 py-3 text-sm font-bold text-ink no-underline transition-all duration-200 hover:bg-sand hover:shadow-lg hover:shadow-sand/10"
					>
						Explore Career Journey
						<span
							class="transition-transform duration-200 group-hover:translate-x-1"
							aria-hidden="true">&rarr;</span
						>
					</a>

					<a
						href="#stack"
						class="inline-flex items-center rounded-full border border-hair bg-ink-soft px-5 py-3 text-sm font-semibold text-chalk no-underline transition-colors duration-200 hover:border-sand/40 hover:text-sand"
					>
						Tech Stack Matrix
					</a>

					<!-- Interactive Copy Email Button -->
					<div class="relative">
						<button
							id="copy-email-btn"
							type="button"
							data-email={SOCIALS.emailRaw}
							class="group inline-flex items-center gap-2 rounded-full border border-hair bg-ink-raise px-4 py-3 text-sm font-mono text-ash transition-colors duration-200 hover:border-sand/50 hover:text-chalk"
							title="Click to copy email address"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-sand transition-transform group-hover:scale-110"
							>
								<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
								<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
							</svg>
							<span id="copy-btn-text">Copy Email</span>
						</button>

						<!-- Tooltip feedback toast -->
						<div
							id="copy-toast"
							role="status"
							class="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 rounded bg-sand px-2.5 py-1 text-xs font-semibold text-ink opacity-0 shadow-md transition-all duration-200"
						>
							Copied to clipboard!
						</div>
					</div>
				</div>

				<!-- Quick Impact Metrics Grid -->
				<div
					class="mt-16 grid w-full grid-cols-2 gap-4 border-t border-hair/70 pt-10 sm:grid-cols-4 sm:gap-6"
				>
					{
						metrics.map((metric) => (
							<div class="flex flex-col rounded-lg border border-hair/50 bg-ink-soft/60 p-4 transition-colors duration-200 hover:border-hair">
								<span class="font-mono text-2xl font-bold tracking-tight text-sand sm:text-3xl">
									{metric.value}
								</span>
								<span class="mt-1 text-sm font-semibold text-chalk">{metric.label}</span>
								<span class="mt-0.5 text-xs text-dust">{metric.sub}</span>
							</div>
						))
					}
				</div>
			</section>

			<!-- Interactive Career Journey Grid -->
			<section id="journey" class="scroll-mt-24 border-t border-hair/60 py-20">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
					<div>
						<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">
							Operational Track Record
						</p>
						<h2 class="mt-1 text-2xl font-bold tracking-tight text-chalk sm:text-3xl">
							Career Journey & Impact
						</h2>
					</div>
					<p class="font-mono text-xs text-dust">Click cards to expand deep dive details</p>
				</div>

				<div class="mt-10 flex flex-col gap-6">
					{
						careerJourney.map((role) => (
							<article
								class="career-card group rounded-xl border border-hair bg-ink-soft/90 p-6 transition-all duration-300 hover:border-sand/40 hover:bg-ink-raise/60 sm:p-8"
								id={`card-${role.id}`}
							>
								<!-- Top metadata bar -->
								<div class="flex flex-wrap items-center justify-between gap-3">
									<div class="flex items-center gap-2.5">
										<span
											class:list={[
												'h-2 w-2 rounded-full',
												role.current ? 'bg-sand shadow-sm shadow-sand' : 'bg-dust',
											]}
										/>
										<span class="font-mono text-xs font-semibold tracking-wider uppercase text-sand">
											{role.company}
										</span>
									</div>
									<span class="rounded border border-hair bg-ink px-2.5 py-0.5 font-mono text-[11px] text-dust">
										{role.period}
									</span>
								</div>

								<!-- Role title -->
								<h3 class="mt-4 text-xl font-bold tracking-tight text-chalk sm:text-2xl">
									{role.role}
								</h3>
								<p class="mt-2 text-sm font-medium text-ash">{role.headline}</p>
								<p class="mt-3 text-[15px] leading-relaxed text-dust">{role.summary}</p>

								<!-- Expandable Deep Dive Section -->
								<div class="mt-6 border-t border-hair/50 pt-4">
									<button
										type="button"
										class="accordion-toggle flex w-full items-center justify-between text-left font-mono text-xs font-semibold text-chalk transition-colors hover:text-sand"
										aria-expanded="false"
										data-target={`details-${role.id}`}
									>
										<span>View Key Operational Wins & Architecture Responsibilities</span>
										<span class="chevron text-sand transition-transform duration-200">↓</span>
									</button>

									<div id={`details-${role.id}`} class="accordion-content mt-4 hidden">
										<ul class="space-y-2.5">
											{role.achievements.map((item) => (
												<li class="flex items-start gap-2.5 text-sm text-ash">
													<span class="mt-1 text-sand">›</span>
													<span>{item}</span>
												</li>
											))}
										</ul>

										<!-- Technology Tags -->
										<div class="mt-5 pt-3 border-t border-hair/30">
											<p class="font-mono text-[10px] uppercase tracking-wider text-dust mb-2">
												Environment & Core Tools
											</p>
											<div class="flex flex-wrap gap-1.5">
												{role.techStack.map((tech) => (
													<span class="rounded bg-ink px-2 py-0.5 font-mono text-xs text-ash border border-hair">
														{tech}
													</span>
												))}
											</div>
										</div>
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- Filterable DevOps & Tech Stack Matrix -->
			<section id="stack" class="scroll-mt-24 border-t border-hair/60 py-20">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
					<div>
						<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">
							Engineered Capabilities
						</p>
						<h2 class="mt-1 text-2xl font-bold tracking-tight text-chalk sm:text-3xl">
							DevOps & Tech Stack Matrix
						</h2>
					</div>
					<p class="text-sm text-dust">Filter by discipline</p>
				</div>

				<!-- Category Filter Pills -->
				<div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Tech categories">
					{
						stackCategories.map((cat, idx) => (
							<button
								type="button"
								class:list={[
									'filter-pill rounded-full px-4 py-1.5 font-mono text-xs transition-all duration-200',
									idx === 0
										? 'bg-sand font-bold text-ink shadow-sm'
										: 'border border-hair bg-ink-soft text-dust hover:border-hair/80 hover:text-chalk',
								]}
								data-category={cat.id}
							>
								{cat.label}
							</button>
						))
					}
				</div>

				<!-- Grid of dynamic stack badges -->
				<div id="stack-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{
						techStack.map((item) => (
							<div
								class="stack-card flex flex-col justify-between rounded-xl border border-hair bg-ink-soft p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-sand/40 hover:bg-ink-raise"
								data-category={item.category}
							>
								<div>
									<div class="flex items-center justify-between gap-2">
										<h3 class="text-lg font-bold text-chalk">{item.name}</h3>
										<span class="rounded bg-ink px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-sand border border-hair">
											{item.status}
										</span>
									</div>
									<p class="mt-1 font-mono text-[11px] uppercase tracking-wide text-dust">
										{item.role}
									</p>
									<p class="mt-3 text-sm leading-relaxed text-ash">{item.description}</p>
								</div>
								<div class="mt-4 pt-3 border-t border-hair/40 flex items-center justify-between">
									<span class="font-mono text-[11px] text-sand">{item.tag}</span>
									<span class="text-xs text-dust">Verified in production</span>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<!-- Interactive DevOps Terminal / Runbook Simulator -->
			<section id="terminal" class="scroll-mt-24 border-t border-hair/60 py-20">
				<div class="flex flex-col gap-2">
					<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">
						Platform Automation In Action
					</p>
					<h2 class="text-2xl font-bold tracking-tight text-chalk sm:text-3xl">
						Interactive Runbook Terminal
					</h2>
					<p class="max-w-xl text-sm leading-relaxed text-ash">
						Click the script tabs to simulate real-world automated diagnostic runs, incident triage routines, and webhook event orchestrations.
					</p>
				</div>

				<!-- Terminal Container -->
				<div class="mt-8 overflow-hidden rounded-xl border border-hair bg-[#0d0d11] shadow-2xl">
					<!-- Terminal Top Bar -->
					<div class="flex flex-wrap items-center justify-between border-b border-hair/80 bg-ink px-4 py-3">
						<div class="flex items-center gap-2">
							<span class="h-3 w-3 rounded-full bg-red-500/80"></span>
							<span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
							<span class="h-3 w-3 rounded-full bg-green-500/80"></span>
							<span class="ml-2 font-mono text-xs text-dust">keshav@platform-node-01:~</span>
						</div>

						<!-- Terminal Scenario Tabs -->
						<div class="flex items-center gap-1.5 pt-2 sm:pt-0">
							{
								terminalScenarios.map((scen, idx) => (
									<button
										type="button"
										class:list={[
											'terminal-tab rounded px-2.5 py-1 font-mono text-xs transition-colors',
											idx === 0
												? 'bg-hair text-chalk font-semibold'
												: 'text-dust hover:text-chalk hover:bg-hair/50',
										]}
										data-scenario={scen.id}
									>
										{scen.title}
									</button>
								))
							}
						</div>
					</div>

					<!-- Terminal Content Panes -->
					<div class="p-5 font-mono text-xs leading-relaxed sm:text-[13px]">
						{
							terminalScenarios.map((scen, idx) => (
								<div
									id={`terminal-pane-${scen.id}`}
									class:list={['space-y-2', idx === 0 ? 'block' : 'hidden']}
								>
									<p class="text-dust pb-1 italic border-b border-hair/40 mb-3"># {scen.desc}</p>
									{scen.output.map((line) => (
										<div class="flex items-start gap-2">
											{line.type === 'cmd' && (
												<span class="text-sand font-bold select-none">$</span>
											)}
											{line.type === 'cmd' && (
												<span class="text-chalk font-semibold">{line.text}</span>
											)}
											{line.type === 'info' && <span class="text-ash">{line.text}</span>}
											{line.type === 'success' && <span class="text-emerald-400">{line.text}</span>}
											{line.type === 'warning' && <span class="text-amber-300">{line.text}</span>}
											{line.type === 'highlight' && (
												<span class="text-sand font-bold">{line.text}</span>
											)}
										</div>
									))}
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Leadership Philosophy -->
			<section id="philosophy" class="scroll-mt-24 border-t border-hair/60 py-20">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">
					Engineering Leadership
				</p>
				<h2 class="mt-1 text-2xl font-bold tracking-tight text-chalk sm:text-3xl">
					Operational Philosophy
				</h2>

				<blockquote class="mt-8 border-l-2 border-sand pl-6 sm:pl-8">
					<p class="max-w-2xl text-xl font-bold leading-snug tracking-[-0.02em] text-chalk sm:text-2xl">
						"Every outage is a conversation between a distributed system and the engineers who keep it alive."
					</p>
				</blockquote>

				<div class="mt-8 grid max-w-3xl gap-6 text-[15px] leading-relaxed text-ash sm:grid-cols-2">
					<p>
						Years in the escalation queue taught me to listen to both sides of that conversation — to
						transform customer stress and recurring Sev-1 panics into deterministic runbooks, automated telemetry, and blameless post-mortems.
					</p>
					<p>
						The leadership principle I bring to DevOps is simple: empower teams with reproducible container infrastructure, declarative deployments, and automation so that production incidents become rare, predictable, and quiet.
					</p>
				</div>
			</section>

			<!-- Writing & Technical Thoughts -->
			<section id="writing" class="scroll-mt-24 border-t border-hair/60 py-20">
				<div class="flex items-baseline justify-between gap-4">
					<div>
						<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">
							Knowledge & Runbooks
						</p>
						<h2 class="mt-1 text-2xl font-bold tracking-tight text-chalk sm:text-3xl">
							Leadership & Technical Writing
						</h2>
					</div>
					<a
						href="/blog"
						class="font-mono text-xs uppercase tracking-[0.14em] text-ash no-underline transition-colors duration-200 hover:text-sand"
					>
						All articles &rarr;
					</a>
				</div>

				<ul class="mt-10 flex flex-col">
					{
						posts.map((post) => (
							<li class="border-t border-hair/60 first:border-t-0">
								<a
									href={`/blog/${post.slug}`}
									class="group flex flex-col gap-2 py-6 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-8 transition-colors"
								>
									<div class="max-w-2xl">
										<div class="flex items-center gap-3">
											<span class="rounded bg-ink-raise px-2 py-0.5 font-mono text-[10px] uppercase text-sand border border-hair">
												{post.category}
											</span>
											<span class="font-mono text-[11px] text-dust">{post.readTime}</span>
										</div>
										<h3 class="mt-2 text-lg font-bold tracking-tight text-chalk transition-colors duration-200 group-hover:text-sand">
											{post.title}
										</h3>
										<p class="mt-1.5 text-sm leading-relaxed text-ash">{post.note}</p>
									</div>
									<div class="flex shrink-0 items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-dust">
										<span>{post.date}</span>
										<span class="text-sand group-hover:translate-x-1 transition-transform">&rarr;</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Say Hello / Contact Section -->
			<section id="contact" class="scroll-mt-24 border-t border-hair/60 py-20">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sand">Connect</p>
				<h2 class="mt-1 text-2xl font-bold tracking-tight text-chalk sm:text-4xl">
					Let&rsquo;s build resilient systems together.
				</h2>
				<p class="mt-4 max-w-xl text-base leading-relaxed text-ash">
					Open to discussions regarding DevOps engineer roles, Kubernetes platform engineering, site reliability leadership, and automated infrastructure.
				</p>

				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a
						href={SOCIALS.email}
						class="inline-flex items-center gap-2 rounded-full bg-sand px-6 py-3 text-sm font-bold text-ink no-underline transition-colors hover:bg-sand-soft"
					>
						Send an Email
					</a>
					<a
						href={SOCIALS.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-full border border-hair bg-ink-soft px-5 py-3 text-sm font-semibold text-chalk no-underline transition-colors hover:border-sand/40 hover:text-sand"
					>
						Connect on LinkedIn
					</a>
					<a
						href={SOCIALS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-full border border-hair bg-ink-soft px-5 py-3 text-sm font-semibold text-chalk no-underline transition-colors hover:border-sand/40 hover:text-sand"
					>
						GitHub Profile
					</a>
				</div>
			</section>
		</main>

		<Footer />

		<!-- Client-Side Interactivity Script -->
		<script is:inline>
			// 1. Copy Email Interaction with Tooltip
			const copyBtn = document.getElementById('copy-email-btn');
			const copyToast = document.getElementById('copy-toast');
			const copyBtnText = document.getElementById('copy-btn-text');

			if (copyBtn && copyToast) {
				copyBtn.addEventListener('click', async () => {
					const email = copyBtn.getAttribute('data-email') || 'keshavec23@gmail.com';
					try {
						await navigator.clipboard.writeText(email);
						copyToast.classList.remove('opacity-0');
						copyToast.classList.add('opacity-100');
						if (copyBtnText) copyBtnText.textContent = 'Copied!';

						setTimeout(() => {
							copyToast.classList.remove('opacity-100');
							copyToast.classList.add('opacity-0');
							if (copyBtnText) copyBtnText.textContent = 'Copy Email';
						}, 2500);
					} catch (err) {
						console.error('Failed to copy text: ', err);
					}
				});
			}

			// 2. Interactive Career Accordion
			document.querySelectorAll('.accordion-toggle').forEach((btn) => {
				btn.addEventListener('click', () => {
					const targetId = btn.getAttribute('data-target');
					const targetContent = document.getElementById(targetId);
					const chevron = btn.querySelector('.chevron');
					const isExpanded = btn.getAttribute('aria-expanded') === 'true';

					if (targetContent) {
						if (isExpanded) {
							targetContent.classList.add('hidden');
							btn.setAttribute('aria-expanded', 'false');
							if (chevron) chevron.textContent = '↓';
						} else {
							targetContent.classList.remove('hidden');
							btn.setAttribute('aria-expanded', 'true');
							if (chevron) chevron.textContent = '↑';
						}
					}
				});
			});

			// 3. Dynamic Tech Stack Matrix Category Filtering
			const filterPills = document.querySelectorAll('.filter-pill');
			const stackCards = document.querySelectorAll('.stack-card');

			filterPills.forEach((pill) => {
				pill.addEventListener('click', () => {
					const category = pill.getAttribute('data-category');

					// Update active pill styling
					filterPills.forEach((p) => {
						p.classList.remove('bg-sand', 'font-bold', 'text-ink', 'shadow-sm');
						p.classList.add('border', 'border-hair', 'bg-ink-soft', 'text-dust');
					});
					pill.classList.remove('border', 'border-hair', 'bg-ink-soft', 'text-dust');
					pill.classList.add('bg-sand', 'font-bold', 'text-ink', 'shadow-sm');

					// Filter cards
					stackCards.forEach((card) => {
						const cardCat = card.getAttribute('data-category');
						if (category === 'all' || cardCat === category) {
							card.style.display = 'flex';
						} else {
							card.style.display = 'none';
						}
					});
				});
			});

			// 4. Interactive DevOps Terminal Simulator Tabs
			const terminalTabs = document.querySelectorAll('.terminal-tab');
			terminalTabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const scenarioId = tab.getAttribute('data-scenario');

					// Update tab styles
					terminalTabs.forEach((t) => {
						t.classList.remove('bg-hair', 'text-chalk', 'font-semibold');
						t.classList.add('text-dust');
					});
					tab.classList.remove('text-dust');
					tab.classList.add('bg-hair', 'text-chalk', 'font-semibold');

					// Show corresponding terminal output pane
					document.querySelectorAll('[id^="terminal-pane-"]').forEach((pane) => {
						pane.classList.add('hidden');
						pane.classList.remove('block');
					});
					const targetPane = document.getElementById(`terminal-pane-${scenarioId}`);
					if (targetPane) {
						targetPane.classList.remove('hidden');
						targetPane.classList.add('block');
					}
				});
			});
		</script>
	</body>
</html>

