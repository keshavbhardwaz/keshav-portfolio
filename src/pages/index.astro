---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from '../consts';

// --- Page data -------------------------------------------------------------

/** What I get brought in to do. Four blocks, four tags each. */
const services = [
	{
		title: 'DXP support & escalation',
		body: 'Front-line and escalation ownership for enterprise Drupal experiences — reading stack traces, reproducing the unreproducible, and getting production quiet again.',
		tags: ['Drupal', 'Acquia Cloud', 'Site Factory', 'Escalations'],
	},
	{
		title: 'Site reliability',
		body: 'Turning recurring customer pain into monitoring, alerting, and runbooks — so the same incident does not get solved twice from scratch.',
		tags: ['Monitoring', 'Incident response', 'SLOs', 'Postmortems'],
	},
	{
		title: 'DevOps & automation',
		body: 'Containerising services, wiring pipelines, and replacing manual toil with code that runs the same way every time.',
		tags: ['Docker', 'Kubernetes', 'AWS', 'CI/CD'],
	},
	{
		title: 'Technical leadership',
		body: 'Documentation, mentoring, and process that scales past one engineer — making the team faster rather than making myself indispensable.',
		tags: ['Mentoring', 'Runbooks', 'Enablement', 'Process'],
	},
];

/** Career rail, newest first. */
const timeline = [
	{
		year: 'Now',
		role: 'DevOps & engineering leadership',
		org: 'In progress',
		note: 'Going deeper into containers, Kubernetes, and cloud infrastructure — building the platform skills to lead, not just support.',
		current: true,
	},
	{
		year: '2023',
		role: 'DXP Support Engineer',
		org: 'Acquia',
		note: 'Supporting Drupal digital experience platforms for enterprise customers. Three and a half years of production debugging, performance tuning, and complex cloud deployments.',
		current: false,
	},
	{
		year: '2021',
		role: 'Operations & Support',
		org: 'Diksha Technologies · Bharti Airtel',
		note: 'Eighteen months on monitoring, ticket triage, and process reliability across Airtel systems. Where I learned that most outages are really communication problems.',
		current: false,
	},
];

/** Tools I actually reach for. */
const stack = [
	{ name: 'Docker', role: 'Containers' },
	{ name: 'Kubernetes', role: 'Orchestration' },
	{ name: 'AWS', role: 'Cloud' },
	{ name: 'CI/CD', role: 'Pipelines' },
	{ name: 'Python', role: 'Automation' },
	{ name: 'n8n', role: 'Workflows' },
];

/** Placeholder posts until the real ones are written. */
const posts = [
	{
		title: 'From support queue to on-call',
		category: 'Reliability',
		date: 'Aug 2026',
		note: 'The escalation queue is the best SRE classroom there is.',
	},
	{
		title: 'Containerising a legacy Drupal stack without downtime',
		category: 'DevOps',
		date: 'Jul 2026',
		note: 'Moving a stateful, plugin-heavy application into Kubernetes one slice at a time.',
	},
	{
		title: 'Error budgets for support engineers',
		category: 'SRE',
		date: 'Jun 2026',
		note: 'Translating customer pain into reliability targets a team can rally behind.',
	},
	{
		title: 'The runbook that wrote itself',
		category: 'Automation',
		date: 'May 2026',
		note: 'What happened when I let n8n handle the parts of my job I kept repeating.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — DXP Support to DevOps`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-ink text-ash">
		<!-- Ambient glow, kept very restrained. -->
		<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
			<div
				class="absolute -top-56 left-1/2 h-[38rem] w-[38rem] -translate-x-1/2 rounded-full bg-sand/[0.07] blur-[140px]"
			>
			</div>
		</div>

		<Header />

		<main id="content" class="mx-auto w-full max-w-5xl px-6 py-0">
			<!-- Hero -->
			<section class="flex flex-col items-start pt-24 pb-28 sm:pt-32 sm:pb-36">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">
					DXP Support Engineer, Acquia
				</p>

				<h1
					class="mt-7 max-w-3xl text-5xl font-bold leading-[0.98] tracking-[-0.03em] text-chalk sm:text-7xl"
				>
					From the escalation queue
					<span class="block text-sand">to the platform.</span>
				</h1>

				<p class="mt-8 max-w-xl text-lg leading-relaxed text-ash">
					Five years keeping production honest — three and a half of them on enterprise Drupal at
					Acquia. Now moving from fixing platforms to building them: containers, cloud
					infrastructure, and the automation that makes outages boring.
				</p>

				<div class="mt-11 flex flex-wrap items-center gap-3">
					<a
						href="/blog"
						class="group inline-flex items-center gap-2 rounded-full bg-chalk px-6 py-3 text-sm font-bold text-ink no-underline transition-colors duration-200 hover:bg-sand"
					>
						View Articles
						<span
							class="transition-transform duration-200 group-hover:translate-x-0.5"
							aria-hidden="true">&rarr;</span
						>
					</a>
					<a
						href="#philosophy"
						class="inline-flex items-center rounded-full border border-hair px-6 py-3 text-sm font-bold text-chalk no-underline transition-colors duration-200 hover:border-sand/50 hover:text-sand"
					>
						Leadership Philosophy
					</a>
				</div>
			</section>

			<!-- What I'm hired for -->
			<section id="work" class="scroll-mt-24 border-t border-hair/60 py-20">
				<h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">
					What I&rsquo;m hired for
				</h2>

				<div class="mt-12 grid gap-x-12 gap-y-12 sm:grid-cols-2">
					{
						services.map((service) => (
							<article class="flex flex-col">
								<h3 class="text-xl font-bold tracking-tight text-chalk">{service.title}</h3>
								<p class="mt-3 flex-1 text-[15px] leading-relaxed text-ash">{service.body}</p>
								<ul class="mt-5 flex flex-wrap gap-x-2 gap-y-2">
									{service.tags.map((tag) => (
										<li class="rounded border border-hair bg-ink-raise px-2.5 py-1 font-mono text-[11px] tracking-wide text-dust">
											{tag}
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
			</section>

			<!-- Career rail -->
			<section id="story" class="scroll-mt-24 border-t border-hair/60 py-20">
				<h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">How I got here</h2>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-chalk">
					Nobody plans a career in escalations. It turned out to be the fastest way to learn how real
					systems fail.
				</p>

				<ol class="mt-14 flex flex-col">
					{
						timeline.map((entry) => (
							<li class="group grid gap-3 border-t border-hair/60 py-8 first:border-t-0 first:pt-0 sm:grid-cols-[7rem_1fr] sm:gap-8">
								<div class="flex items-center gap-2.5">
									<span
										class:list={[
											'h-1.5 w-1.5 shrink-0 rounded-full',
											entry.current ? 'bg-sand' : 'bg-hair',
										]}
										aria-hidden="true"
									/>
									<span
										class:list={[
											'font-mono text-xs tracking-widest uppercase',
											entry.current ? 'text-sand' : 'text-dust',
										]}
									>
										{entry.year}
									</span>
								</div>

								<div>
									<h3 class="text-lg font-bold tracking-tight text-chalk">{entry.role}</h3>
									<p class="mt-0.5 text-sm text-dust">{entry.org}</p>
									<p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ash">{entry.note}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<!-- Stack -->
			<section id="stack" class="scroll-mt-24 border-t border-hair/60 py-20">
				<h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">Working stack</h2>

				<ul class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-hair bg-hair sm:grid-cols-3 lg:grid-cols-6">
					{
						stack.map((tool) => (
							<li class="flex flex-col items-center gap-1.5 bg-ink-soft px-4 py-7 text-center transition-colors duration-200 hover:bg-ink-raise">
								<span class="text-[15px] font-bold text-chalk">{tool.name}</span>
								<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-dust">
									{tool.role}
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Leadership philosophy -->
			<section id="philosophy" class="scroll-mt-24 border-t border-hair/60 py-20">
				<h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">
					Leadership philosophy
				</h2>

				<blockquote class="mt-10 border-l-2 border-sand pl-6 sm:pl-8">
					<p class="max-w-2xl text-2xl font-bold leading-snug tracking-[-0.02em] text-chalk sm:text-3xl">
						Every outage is a conversation between a system and the people who depend on it.
					</p>
				</blockquote>

				<div class="mt-10 grid max-w-3xl gap-6 text-[15px] leading-relaxed text-ash sm:grid-cols-2">
					<p>
						Years on the escalation queue taught me to listen to both sides of that conversation — to
						turn customer frustration into runbooks, automation, and honest post-incident learning
						instead of blame.
					</p>
					<p>
						The goal I carry into leadership is the one that made me a decent support engineer: build
						teams and platforms that fail gracefully, recover fast, and get a little more boring
						every quarter.
					</p>
				</div>
			</section>

			<!-- Writing -->
			<section id="writing" class="scroll-mt-24 border-t border-hair/60 py-20">
				<div class="flex items-baseline justify-between gap-4">
					<h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">Writing</h2>
					<a
						href="/blog"
						class="font-mono text-[11px] uppercase tracking-[0.14em] text-ash no-underline transition-colors duration-200 hover:text-sand"
					>
						All posts &rarr;
					</a>
				</div>

				<ul class="mt-10 flex flex-col">
					{
						posts.map((post) => (
							<li class="border-t border-hair/60 first:border-t-0">
								<a
									href="/blog"
									class="group flex flex-col gap-2 py-6 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
								>
									<div class="max-w-2xl">
										<h3 class="text-lg font-bold tracking-tight text-chalk transition-colors duration-200 group-hover:text-sand">
											{post.title}
										</h3>
										<p class="mt-1.5 text-[15px] leading-relaxed text-ash">{post.note}</p>
									</div>
									<div class="flex shrink-0 items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-dust">
										<span>{post.category}</span>
										<span aria-hidden="true">&middot;</span>
										<span>{post.date}</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Contact -->
			<section id="contact" class="scroll-mt-24 border-t border-hair/60 py-20">
				<h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-dust">Say hello</h2>
				<p class="mt-6 max-w-xl text-2xl font-bold leading-snug tracking-[-0.02em] text-chalk">
					Open to conversations about DevOps roles, platform reliability, and leading support-led
					engineering teams.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
					<a
						href={SOCIALS.email}
						class="text-[15px] text-sand no-underline transition-colors duration-200 hover:text-sand-soft"
					>
						hello@example.com
					</a>
					<a
						href={SOCIALS.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[15px] text-ash no-underline transition-colors duration-200 hover:text-chalk"
					>
						LinkedIn
					</a>
					<a
						href={SOCIALS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[15px] text-ash no-underline transition-colors duration-200 hover:text-chalk"
					>
						GitHub
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
